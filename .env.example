# Telegram: заполните локально
ADMINS_ID=
BOT_TOKEN=
KINO_API_TOKEN=
BOOKS_API_TOKEN=
RAWG_API_TOKEN=

POSTGRES_DB=chill_zone
DATABASE_USER=chill_zone_dev
DATABASE_PASSWORD=local_example_change_me

# JVM на хосте -> PostgreSQL из Docker Compose (порт хоста 5430).
DATABASE_URL=jdbc:postgresql://localhost:5430/chill_zone
# Бот внутри Compose -> PostgreSQL по имени сервиса и внутреннему порту 5432
# Compose сам переопределяет DATABASE_URL для bot и bot-dev с учётом POSTGRES_DB.
# При изменении POSTGRES_DB обновите также URL для локальной JVM.
# Учётные данные и имя БД применяются при первом создании PostgreSQL volume;
# изменение этих значений не перенастраивает уже существующую базу.
